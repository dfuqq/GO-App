{
	"compilerOptions": {
		"target": "ES6",
		"module": "ESNext",
		"strict": false,
		"jsx": "react-jsx",
		"moduleResolution": "node",
		"baseUrl": "./src",
		"paths": {
			"@components/*": ["components/*"]
		},
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ES6", "DOM", "DOM.Iterable"],
		// XXX: delete in future
		"resolveJsonModule": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "build", "dist"]
}
