generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["postgresqlExtensions"]
}

datasource db {
    provider  = "postgresql"
    url       = env("POSTGRES_URL")
    directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum BusinessCategoryType {
    RESTAURANT
    CAFE
    BAR
    HOOKAH
    OTHER
}

enum PlaceCategoryType {
    PARK
    MUSEUM
    MONUMENT
    ENTERTAINMENT
    ARCHITECTURE
    OTHER
}

model Business {
    slug              String           @id @default(uuid())
    name              String
    subtitle          String
    description       String
    descriptionHeader String
    address           String
    hours             String
    priceFrom         String
    priceTo           String
    phone             String
    logo              String
    categoryId        Int
    category          BusinessCategory @relation(fields: [categoryId], references: [id])
    images            Image[]
    social            String?
    socialHref        String?
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt

    @@map("businesses")
}

model Place {
    slug              String        @id @default(uuid())
    name              String
    subtitle          String
    description       String
    descriptionHeader String
    address           String
    hours             String?
    categoryId        Int
    category          PlaceCategory @relation(fields: [categoryId], references: [id])
    images            Image[]
    createdAt         DateTime      @default(now())
    updatedAt         DateTime      @updatedAt

    @@map("places")
}

model BusinessCategory {
    id          Int                  @id @default(autoincrement())
    name        String
    description String?
    type        BusinessCategoryType @default(OTHER)
    businesses  Business[]
    createdAt   DateTime             @default(now())
    updatedAt   DateTime             @updatedAt

    @@map("business_categories")
}

model PlaceCategory {
    id          Int               @id @default(autoincrement())
    name        String
    description String?
    type        PlaceCategoryType @default(OTHER)
    places      Place[]
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt

    @@map("place_categories")
}

model Image {
    id           Int       @id @default(autoincrement())
    src          String
    alt          String
    business     Business? @relation(fields: [businessSlug], references: [slug])
    businessSlug String?
    place        Place?    @relation(fields: [placeSlug], references: [slug])
    placeSlug    String?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    @@map("images")
}
